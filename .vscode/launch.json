{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "CLI (debug)",
			"type": "node",
			"request": "attach",
			"port": 9229
		},
		{
			"name": "CLI (launch + debug)",
			"type": "node",
			"request": "launch",
			"runtimeArgs": ["--import", "tsx"],
			"program": "${workspaceFolder}/packages/cli/src/main.ts",
			"args": ["--year", "2024"],
			"cwd": "${workspaceFolder}/packages/cli"
		}
	]
}
