{
	"name": "@brrr/lib",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./info/node": {
			"types": "./dist/InfoProviders/Node/NodeInfoProvider.d.mts",
			"default": "./dist/InfoProviders/Node/NodeInfoProvider.mjs"
		}
	},
	"scripts": {
		"dev": "tsdown --watch --no-clean --no-report",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"build": "tsdown"
	},
	"dependencies": {
		"csv-stringify": "catalog:",
		"fast-xml-parser": "catalog:",
		"inversify": "catalog:",
		"luxon": "catalog:",
		"yahoo-finance2": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@brrr/test-cases": "workspace:*",
		"@types/luxon": "catalog:",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"vitest": "catalog:"
	}
}
